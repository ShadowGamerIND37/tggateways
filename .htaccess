Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(includes|database|cron|sdk|examples|storage)(/|$) - [F,L]
  # The .txt documentation endpoints are generated by PHP, so they need
  # explicit passthrough rules before the static file handler sees them.
  RewriteRule ^docs\.txt$ docs.txt.php [L]
  RewriteRule ^llms\.txt$ llms.txt.php [L]
  RewriteRule ^ai-prompt\.txt$ ai-prompt.txt.php [L]
  RewriteRule ^api/create-order/?$ api/create-order.php [QSA,L]
  RewriteRule ^api/manage-links/?$ api/manage-links.php [QSA,L]
  RewriteRule ^api/verify-order/?$ api/verify-order.php [QSA,L]
  RewriteRule ^api/get-transactions/?$ api/get-transactions.php [QSA,L]
</IfModule>
<FilesMatch "^(\.env|composer\.(json|lock)|README\.md)$">
  Require all denied
</FilesMatch>
