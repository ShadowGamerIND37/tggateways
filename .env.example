APP_ENV=production
APP_URL=http://localhost:8080
# Set true behind HTTPS in production. Local http://localhost development needs false.
SESSION_SECURE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tggateways
DB_USER=tggateways
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
TG_HTTP_PORT=8080
# Generate 32 random bytes and hex-encode (64 chars); do not commit the real value.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters
