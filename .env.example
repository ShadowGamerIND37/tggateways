APP_ENV=production
# Set true only on a development machine: shows PHP diagnostics in responses.
# Keep false in production, and never enable it on a deployment that takes payments.
APP_DEBUG=false
# Public base URL, used to build checkout links and payment-link URLs.
# Under Compose this is derived from TG_HTTP_PORT automatically, so leave it
# commented out for localhost and change only TG_HTTP_PORT below. Uncomment and
# set your real https:// domain for production, and ALWAYS set it for a
# bare-metal install without Docker.
# APP_URL=https://pay.example.com
# Set true behind HTTPS in production. Local http://localhost development needs false.
SESSION_SECURE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tggateways
DB_USER=tggateways
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
# Host port published by the web container. Change it if the default is taken
# (the build itself never needs the port; only publishing does).
TG_HTTP_PORT=8090
# Generate 32 random bytes and hex-encode (64 chars); do not commit the real value.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters
# Session lifetime in seconds (default 24h) and cookie transport (true behind HTTPS).
SESSION_LIFETIME=86400
# Set false only for local development against a self-signed IMAP server.
IMAP_VALIDATE_CERT=true
# Optional: SQLite instead of MySQL, useful for a quick local trial.
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=/var/www/html/storage/tg.sqlite
