{
  "openapi": "3.0.3",
  "info": {
    "title": "TG Gateways API",
    "version": "1.0.0",
    "description": "API for a self-hosted direct-to-merchant UPI checkout starter. Provider settlement and receipt validation remain merchant responsibilities."
  },
  "servers": [{"url": "https://tggateways.in", "description": "Example deployment; replace with your own host"}],
  "components": {
    "securitySchemes": {"ApiKey": {"type": "apiKey", "in": "header", "name": "X-Api-Key"}},
    "schemas": {
      "OrderCreate": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": {"type": "number", "minimum": 1},
          "customer_name": {"type": "string"},
          "customer_email": {"type": "string", "format": "email"},
          "customer_phone": {"type": "string"},
          "redirect_url": {"type": "string", "format": "uri"},
          "webhook_url": {"type": "string", "format": "uri"}
        }
      },
      "OrderCreated": {
        "type": "object",
        "description": "Created. Absolute URLs are built from APP_URL, so they match the deployment host and port.",
        "properties": {
          "order_id": {"type": "string"},
          "status": {"type": "string"},
          "currency": {"type": "string"},
          "amount": {"type": "number"},
          "payable_amount": {"type": "number"},
          "checkout_url": {"type": "string", "format": "uri"},
          "checkout_path": {"type": "string"},
          "qr_url": {"type": "string", "format": "uri", "description": "Absolute QR image URL for this order."},
          "qr_path": {"type": "string", "description": "Path-only form of qr_url."},
          "upi_intent": {"type": "string"},
          "upi_id": {"type": "string"},
          "expires_at": {"type": "string"},
          "expires_in_seconds": {"type": "integer"}
        }
      }
    }
  },
  "paths": {
    "/api/create-order": {
      "post": {
        "summary": "Create a UPI checkout order",
        "description": "Creates a hosted UPI checkout order. Retry-safe when an Idempotency-Key header is supplied: the request is performed at most once.",
        "security": [{"ApiKey": []}],
        "parameters": [{"name": "Idempotency-Key", "in": "header", "required": false, "description": "Caller-generated unique string, at most 190 printable ASCII characters. A retry with the same key and the same body returns the original order with the original status code and an Idempotent-Replay: true header, and creates no second order. Reusing a key with a different body returns 409. Scoped per merchant; replayable for 24 hours.", "schema": {"type": "string", "maxLength": 190, "example": "b1c2d3e4-5f60-4718-9a2b-3c4d5e6f7081"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderCreate"}}}},
        "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OrderCreated"}}}}, "401": {"description": "Invalid API key"}, "422": {"description": "Invalid order fields"}, "409": {"description": "Idempotency-Key reused with a different body, or a request with this key is still in flight (the latter carries Retry-After: 1).", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string"}, "hint": {"type": "string"}}}}}}}
      }
    },
    "/api/checkout-status.php": {
      "get": {
        "summary": "Public checkout status for display",
        "parameters": [{"name": "order_id", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Current display status"}}
      }
    },
    "/api/verify-order.php": {
      "get": {
        "summary": "Authoritative merchant order lookup",
        "security": [{"ApiKey": []}],
        "parameters": [{"name": "order_id", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Order status"}, "404": {"description": "Order not found"}}
      }
    },
    "/api/qr-image.php": {
      "get": {
        "summary": "UPI QR PNG",
        "parameters": [{"name": "order_id", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "PNG image"}, "503": {"description": "QR generation dependency not installed"}}
      }
    },
    "/api/manage-links.php": {
      "get": {"summary": "List merchant payment links", "security": [{"ApiKey": []}], "responses": {"200": {"description": "Payment links"}}},
      "post": {"summary": "Create a payment link", "security": [{"ApiKey": []}], "responses": {"201": {"description": "Created"}}}
    },
    "/api/get-transactions.php": {
      "get": {
        "summary": "Get merchant transaction history",
        "security": [{"ApiKey": []}],
        "parameters": [{"name": "status", "in": "query", "schema": {"type": "string"}}, {"name": "page", "in": "query", "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "Transactions"}}
      }
    }
  }
}
